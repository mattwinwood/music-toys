# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...
PORT=3220

# Required for in-page YouTube playback. Without it, toys link out to YouTube
# search instead of embedding the player.
# Get a free key at https://console.cloud.google.com/apis/credentials
# (enable the "YouTube Data API v3" service first).
YOUTUBE_API_KEY=
